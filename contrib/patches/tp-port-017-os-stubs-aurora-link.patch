-void C_MTXLookAt(Mtx mtx, const Vec* camPos, const Vec* camUp, const Vec* target) {
-    Vec look, right, up;
-
-    // look = normalize(target - camPos)
-    look.x = target->x - camPos->x;
-    look.y = target->y - camPos->y;
