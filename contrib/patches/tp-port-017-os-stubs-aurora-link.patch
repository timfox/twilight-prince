-
-    // up = right × look
-    up.x = right.y * look.z - right.z * look.y;
-    up.y = right.z * look.x - right.x * look.z;
-    up.z = right.x * look.y - right.y * look.x;
-
-    mtx[0][0] = right.x; mtx[0][1] = right.y; mtx[0][2] = right.z;
