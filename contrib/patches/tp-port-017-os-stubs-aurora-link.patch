-    f32 mag = sqrtf(look.x * look.x + look.y * look.y + look.z * look.z);
-    if (mag > 0.0f) { look.x /= mag; look.y /= mag; look.z /= mag; }
-
-    // right = normalize(look × camUp)
-    right.x = look.y * camUp->z - look.z * camUp->y;
-    right.y = look.z * camUp->x - look.x * camUp->z;
