-// Matrix inverse (3x4)
-u32 C_MTXInverse(const Mtx src, Mtx inv) {
-    // Compute determinant of upper-left 3x3
-    f32 det = src[0][0] * (src[1][1] * src[2][2] - src[1][2] * src[2][1])
-            - src[0][1] * (src[1][0] * src[2][2] - src[1][2] * src[2][0])
-            + src[0][2] * (src[1][0] * src[2][1] - src[1][1] * src[2][0]);
-
-    if (fabsf(det) < 1e-10f) return 0;  // Singular matrix
-
-    f32 invDet = 1.0f / det;
-
-    // Compute inverse of 3x3 rotation part
-    inv[0][0] = (src[1][1] * src[2][2] - src[1][2] * src[2][1]) * invDet;
-    inv[0][1] = (src[0][2] * src[2][1] - src[0][1] * src[2][2]) * invDet;
-    inv[0][2] = (src[0][1] * src[1][2] - src[0][2] * src[1][1]) * invDet;
-    inv[1][0] = (src[1][2] * src[2][0] - src[1][0] * src[2][2]) * invDet;
-    inv[1][1] = (src[0][0] * src[2][2] - src[0][2] * src[2][0]) * invDet;
-    inv[1][2] = (src[0][2] * src[1][0] - src[0][0] * src[1][2]) * invDet;
-    inv[2][0] = (src[1][0] * src[2][1] - src[1][1] * src[2][0]) * invDet;
-    inv[2][1] = (src[0][1] * src[2][0] - src[0][0] * src[2][1]) * invDet;
-    inv[2][2] = (src[0][0] * src[1][1] - src[0][1] * src[1][0]) * invDet;
-
-    // Compute translation: -inv(R) * t
-    inv[0][3] = -(inv[0][0] * src[0][3] + inv[0][1] * src[1][3] + inv[0][2] * src[2][3]);
-    inv[1][3] = -(inv[1][0] * src[0][3] + inv[1][1] * src[1][3] + inv[1][2] * src[2][3]);
-    inv[2][3] = -(inv[2][0] * src[0][3] + inv[2][1] * src[1][3] + inv[2][2] * src[2][3]);
-
-    return 1;
-}
